{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Veltrah: Run demo",
      "type": "process",
      "command": "sh",
      "args": ["${workspaceFolder}/tools/launch_demo.sh", "--open"],
      "windows": {
        "command": "cmd.exe",
        "args": ["/d", "/c", "tools\\launch_demo.cmd", "--open"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Veltrah: Smoke check (no npm required)",
      "type": "process",
      "command": "sh",
      "args": ["${workspaceFolder}/tools/launch_demo.sh", "--smoke-check"],
      "windows": {
        "command": "cmd.exe",
        "args": ["/d", "/c", "tools\\launch_demo.cmd", "--smoke-check"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ]
}
