{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Veltrah: Debug demo (Python extension)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_demo.py",
      "args": ["--open"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
